# Function to display an image in a window with a wait for a key press
def show_image(title, image, save_debug=False, tip=None):  
    if not (ENABLE_SHOW_IMAGES or (save_debug and ENABLE_DEBUG_SAVE)):
        return

    # Convert grayscale to BGR for visualization if needed
    if len(image.shape) == 2:
        image = cv2.cvtColor(image, cv2.COLOR_GRAY2BGR)
    else:
        image = image.copy()   # never draw on the caller's array

    if tip is not None:
        # Draw a red circle at the tip location for visualization
        cv2.circle(image, tuple(int(v) for v in tip), 6, (0, 0, 255), 2, cv2.LINE_AA)

    if ENABLE_SHOW_IMAGES:    
        cv2.namedWindow(title, cv2.WINDOW_KEEPRATIO)
        cv2.resizeWindow(title, 1500, 1000)
        cv2.imshow(title, image)

        cv2.waitKey(0)
        cv2.destroyAllWindows()
    
    # Get file version for debugging (fall back to the whole stem if the name isn't v<num>_)
    stem = os.path.splitext(os.path.basename(__file__))[0]
    parts = [p for p in stem.split('_') if p.startswith('v') and p[1:].isdigit()]
    folder_name_version = parts[-1][1:] if parts else stem

    # Add current just the python file name to the saved image title for easier debugging and review of results
    title = CURRENT_IMAGE + "_" + title

    # Save the image to disk for later review
    if save_debug and ENABLE_DEBUG_SAVE:
        print(f"Saving debug image: {title}")
        save_path = os.path.join('debug_outputs/' + folder_name_version, f"{title.replace(' ', '_')}.jpg")
        os.makedirs('debug_outputs/' + folder_name_version, exist_ok=True)
        cv2.imwrite(save_path, image)
    

# Show the skeleton overlaid on the original grayscale image
def overlay_skeleton_on_gray(gray_image, skeleton, color=(0, 255, 0)):
    """
    Overlay a skeleton in the specified color on top of a grayscale image.

    Parameters:
        gray_image (np.ndarray): 2D uint8 grayscale image.
        skeleton (np.ndarray): 2D binary image (0/255) of skeleton.
        color (tuple): BGR color for the skeleton overlay (default is green).

    Returns:
        np.ndarray: BGR image with skeleton overlaid in the specified color.
    """
    # Back to 3-channel BGR
    if len(gray_image.shape) == 2:
        bgr = cv2.cvtColor(gray_image, cv2.COLOR_GRAY2BGR)
    else:
        bgr = gray_image.copy()

    # Color mask for skeleton or path
    path_mask = np.zeros_like(bgr)
    path_mask[skeleton > 0] = color

    overlay = cv2.addWeighted(bgr, 1.0, path_mask, 1.0, 0)
    return overlay


# Function to find endpoints in a skeleton
def find_endpoints(skeleton):
    kernel = np.array([[1,1,1],
                       [1,10,1],
                       [1,1,1]])
    
    skel = (skeleton > 0).astype(np.uint8)
    conv = convolve(skel, kernel, mode='constant', cval=0)
    
    endpoints = (conv == 11).astype(np.uint8)   # 10 from the center pixel + 1 from exactly one neighbour = 11
    return endpoints


# Endpoint bridging function
# TODO REMOVE IF smart connect works better
def bridge_endpoints_via_dilation(skeleton, max_bridge_dist=10):
    skel = (skeleton > 0).astype(np.uint8)

    # Get endpoints 
    endpoints = find_endpoints(skel)

    # Dilate endpoints
    radius = max_bridge_dist // 2
    kernel = cv2.getStructuringElement(
        cv2.MORPH_ELLIPSE, (2*radius+1, 2*radius+1)
    )
    dilated = cv2.dilate(endpoints, kernel)

    # Skeletonize the dilated endpoints (this creates bridges)
    bridges = skeletonize(dilated > 0).astype(np.uint8)

    # Combine with original skeleton
    combined = np.logical_or(skel, bridges).astype(np.uint8)

    # Normalize to 0/255
    combined = skeletonize(combined).astype(np.uint8) * 255

    return combined


# Find the needle tip by skeletonizing the cleaned mask
def find_needle_tip(needle_mask, orig_image, show=True, search_ratio=1.0, open_iter=2):
    """
    Args:
        needle_mask : np.ndarray, uint8
            Needle outline after preprocessing (needle = 255, background = 0)
        orig_image : np.ndarray
            Original grayscale image for visualization
        show : bool
            If True, draws a red circle at the tip and shows using show_image()
        search_ratio : float
            Fraction of width (from the RIGHT side) to process, in (0, 1]. Use 1.0 to process full image.
        open_iter : int
            Morphological opening iterations to reduce speckle noise.

    Returns:
    (int, int)
        Tip (x, y) in full-image coordinates.
    """

    if needle_mask.dtype != np.uint8:
        raise ValueError("needle_mask must be uint8 with values 0/255.")
    if needle_mask.ndim != 2:
        raise ValueError("needle_mask must be a single-channel image.")

    # Limit to right portion of the image based on search_ratio
    h, w = needle_mask.shape
    search_ratio = float(np.clip(search_ratio, 1e-3, 1.0))
    x0 = int(w * (1 - search_ratio))
    roi = needle_mask[:, x0:w]

    # Clean small speckles using morphological opening - dilation followed by erosion
    kernel = np.ones((3,3), np.uint8)
    clean = cv2.morphologyEx(roi, cv2.MORPH_OPEN, kernel, iterations=open_iter)
    
    #show_image("Cleaned after opening", clean)

    # Ensure a single main component (remove small components)
    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats((clean > 0).astype(np.uint8), connectivity=8)
    if num_labels <= 1:
        raise ValueError("No foreground found after cleanup.")
    # Keep the largest component by area (ignoring background label 0)
    areas = stats[1:, cv2.CC_STAT_AREA]
    keep_label = 1 + int(np.argmax(areas))
    main = (labels == keep_label).astype(np.uint8) * 255
    
    #show_image("Largest Component", main)

    # Skeleton
    skel = skeletonize(main > 0)
    if not np.any(skel):
        raise ValueError("Skeleton is empty; try reducing open_iter or widening search_ratio.")

    # Find skeleton endpoints (pixels with exactly 1 8-neighbour)
    skel_u8 = skel.astype(np.uint8)
    # 8-neighbourhood count via convolution
    kernel8 = np.array([[1,1,1],
                        [1,0,1],
                        [1,1,1]], dtype=np.uint8)
    neighbor_count = cv2.filter2D(skel_u8, -1, kernel8, borderType=cv2.BORDER_CONSTANT)
    endpoints_y, endpoints_x = np.where((skel_u8 == 1) & (neighbor_count == 1))
    if len(endpoints_x) < 1:
        raise ValueError("No endpoints found on skeleton.")

    # --- PCA on foreground to get major axis direction ---
    ys_fg, xs_fg = np.where(main > 0)
    if len(xs_fg) < 2:
        raise ValueError("Insufficient foreground pixels for PCA.")
    pts = np.column_stack((xs_fg, ys_fg)).astype(np.float32)
    mean, eigenvectors = cv2.PCACompute(pts, mean=None, maxComponents=2)
    v = eigenvectors[0]  # principal direction (unit-ish vector)
    v = v / np.linalg.norm(v)  # normalize to unit length

    # For consistency, point the axis roughly to the RIGHT (positive x).
    # If v points left, flip it so positive projection is "to the right".
    if v[0] < 0:
        v = -v

    # Project endpoints on the major axis (in ROI coords)
    # We want the endpoint with the MINIMUM projection -> "leftmost along the axis".
    # Use centered coordinates (subtract mean) to be robust.
    mean_xy = mean.ravel()  # (mx, my) in ROI coords
    proj_vals = []
    endpoint_coords = []
    for ex, ey in zip(endpoints_x, endpoints_y):
        p = np.array([ex, ey], dtype=np.float32)
        proj = np.dot((p - mean_xy), v)  # scalar projection onto major axis
        proj_vals.append(proj)
        endpoint_coords.append((int(ex), int(ey)))

    # Leftmost along major axis = smallest projection
    idx = int(np.argmin(proj_vals))
    tip_local = endpoint_coords[idx]  # (x, y) in ROI coords

    # Convert to full-image coordinates
    tip_global = (tip_local[0] + x0, tip_local[1])

    # Visualise (single red circle) on original grayscale image
    if show:
        show_image("Detected Tip", orig_image, tip=tip_global)

    return tip_global


# Run the full needle tip detection pipeline
def needle_tip_detection_pipeline(gray, s_r=0.5):
    clahe = cv2.createCLAHE(
        clipLimit=7.0,
        tileGridSize=(12,12)
    ) 
    gray_clahe = clahe.apply(gray)

    show_image("Grayscale Image with CLAHE", gray_clahe)

    # Simple thresholding to get needle mask
    _, binary_mask = cv2.threshold(gray_clahe, 100, 255, cv2.THRESH_BINARY_INV)  # adjust threshold as needed

    show_image("Binary Mask", binary_mask)
    
    # Big opening to disconnect branches and isolate the needle
    # Clears up some branches but also erases a bit of the needle tip. There are cases where this is still sufficient - big AC bushes 
    # Ideally needs detection from the initial image as branches can cause the tip to be misplaced
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(6, 6))
    binary_mask = cv2.morphologyEx(binary_mask, cv2.MORPH_OPEN, kernel, iterations=3)

    clean_needle = binary_mask.copy()
    # clean_needle = clean_needle_mask(binary_mask, min_area_frac=0.0005) # currently unused - as unnecessary

    tip = find_needle_tip(clean_needle, gray, search_ratio=s_r)
    
    return tip
    

# Adjust the tip of the needle to the skeleton
def snap_to_skeleton(skeleton, tip, radius=20, prefer_global_largest=False):
    h, w = skeleton.shape
    y0 = max(0, tip[1] - radius)
    x0 = max(0, tip[0] - radius)
    y1 = min(h, tip[1] + radius + 1)
    x1 = min(w, tip[0] + radius + 1)

    skel_patch = skeleton[y0:y1, x0:x1]
    if skel_patch.size == 0:
        print("Snap patch empty (tip outside image?); returning original tip.")
        return tip

    # Guard path: ignore the patch, snap to the nearest pixel of the biggest
    # component in the whole image. Used when the patch-local choice stranded
    # the seed on needle debris.
    if prefer_global_largest:
        _, g_labels, g_stats, _ = cv2.connectedComponentsWithStats(
            (skeleton > 0).astype(np.uint8), connectivity=8)
        g_areas = g_stats[1:, cv2.CC_STAT_AREA]
        if g_areas.size == 0:
            print("No skeleton components in image; returning original tip.")
            return tip
        g_mask = (g_labels == 1 + int(np.argmax(g_areas)))
        g_ys, g_xs = np.where(g_mask)
        g_d = (g_xs - tip[0])**2 + (g_ys - tip[1])**2
        g_i = int(np.argmin(g_d))
        return (int(g_xs[g_i]), int(g_ys[g_i]))

    _, labels, stats, _ = cv2.connectedComponentsWithStats(
    (skel_patch > 0).astype(np.uint8), connectivity=8
    )       

    areas = stats[1:, cv2.CC_STAT_AREA]
    
    if areas.size == 0:
        print("No skeleton components found in patch; returning original tip.")
        return tip
    
    largest = 1 + int(np.argmax(areas))
    mask = (labels == largest)
    
    ys, xs = np.where(mask)

    # convert to global coords
    xs_global = xs + x0
    ys_global = ys + y0

    # Find the skeleton pixel closest to the original tip
    dists_sqr = (xs_global - tip[0])**2 + (ys_global - tip[1])**2
    idx = np.argmin(dists_sqr)

    start = (int(xs_global[idx]), int(ys_global[idx]))

    return start


# Extract the skeleton pixels connected to the tip
def connected_skeleton_component(skeleton, tip):
    # Make a copy to avoid modifying the original
    skel_img = (skeleton * 255).astype(np.uint8)

    # OpenCV requires a mask 2 pixels larger in each dimension
    mask = np.zeros((skel_img.shape[0] + 2, skel_img.shape[1] + 2), np.uint8)

    # Flood-fill starting at the tip
    seed = (tip[0], tip[1])
    fill_value = 128  # must not conflict with 0 or 255
    cv2.floodFill(skel_img, mask, seed, fill_value, flags=8)

    # Extract the filled component as a binary mask
    connected_component = (skel_img == fill_value).astype(np.uint8) * 255

    return connected_component


def hysteresis_thresholding(image, low_thresh, high_thresh):
    high = np.percentile(image, high_thresh)   # strong vessel response
    low  = np.percentile(image, low_thresh)   # weaker but potentially valid

    strong = (image >= high).astype(np.uint8)
    weak   = (image >= low).astype(np.uint8)

    kernel = np.ones((3,3), np.uint8)

    # Grow strong regions into weak areas using dilation until no change occurs
    while True:
        dilated = cv2.dilate(strong, kernel)
        new_strong = np.logical_and(dilated, weak)
        
        if np.array_equal(new_strong, strong):
            break
            
        strong = new_strong.astype(np.uint8)

    thresh = (strong * 255).astype(np.uint8)
    return thresh


# Find the longest path with Dijkstra's algorithm from the tip to the farthest reachable skeleton pixel
def find_longest_path_from_tip(skeleton, tip):
    skel = (skeleton > 0).astype(np.uint8)
    rows, cols = np.where(skel)

    if len(rows) == 0:
        print("Skeleton is empty.")
        return np.zeros_like(skeleton, dtype=np.uint8), 0

    # Build graph from 8-connected skeleton pixels
    G = nx.Graph()
    coords = set(zip(rows.tolist(), cols.tolist()))

    for r, c in coords:
        G.add_node((r, c))
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                nb = (r + dr, c + dc)
                if nb in coords:
                    w = 1.4142 if (dr != 0 and dc != 0) else 1.0        # diagonals are counted as sqrt(2)=1.4142 to reflect actual distance
                    G.add_edge((r, c), nb, weight=w)

    # Convert tip (x, y) → (row, col)
    tip_node = (tip[1], tip[0])
    fallback = tip_node not in G
    if fallback:
        nodes_arr = np.array(list(G.nodes()))
        dists = np.linalg.norm(nodes_arr - np.array(tip_node), axis=1)
        tip_node = tuple(nodes_arr[np.argmin(dists)])

    # Only work within the connected component containing the tip
    tip_component = nx.node_connected_component(G, tip_node)
    G = G.subgraph(tip_component).copy()

    # Using Dijkstra's algorithm to find the farthest pixel and the path to it.
    dist = nx.single_source_dijkstra_path_length(G, tip_node, weight='weight')
    farthest = max(dist, key=dist.get)
    path = nx.dijkstra_path(G, tip_node, farthest, weight='weight')

    path_length = dist[farthest]                       # geodesic length in px
    n_pixels = len(path)                               # pixel count, for reference

    # Build path mask
    h, w = skel.shape
    path_mask = np.zeros((h, w), dtype=np.uint8)
    for r, c in path:
        if 0 <= r < h and 0 <= c < w:
            path_mask[r, c] = 255

    far_xy = (int(farthest[1]), int(farthest[0]))      # back to (x, y)
    print(f"Longest path from tip: {path_length:.1f} px geodesic "
          f"({n_pixels} pixels) | far_end={far_xy}")

    return path_mask, path_length, far_xy


# Run the full tree extraction pipeline after finding the needle tip
def branch_extraction_pipeline(gray, tip):
    gray = cv2.GaussianBlur(gray, (5, 5), 0)
    show_image("Blurred Grayscale", gray)
    
    # Sato vesselness filter
    # Dark ridges (black_ridges=True)
    # Tuning: if thin tips are missed, lower the sigma minimum 
    #         if thick branches are missed, raise the sigma maximum 
    vessel = sato(
        gray.astype(np.float32) / 255.0,        # float32 because skimage upcasts anyway, saves processing time
        sigmas=SIGMAS,
        black_ridges=True
    )

    p_high = np.percentile(vessel, 99.7)   # clip top 0.5% — removes needle body saturation, TODO check if this doesn't remove important features, i.e neeedle always brighter
    vessel_clipped = np.clip(vessel, 0, p_high) / p_high
    vessel_norm = (vessel_clipped * 255).astype(np.uint8)
    show_image("Sato Clipped Vesselness", vessel_norm, save_debug=True)
    
    # Threshold the vesselness map
    thresh = hysteresis_thresholding(vessel_norm, low_thresh=70, high_thresh=95)
    show_image("Hysteresis Thresholded Vesselness", thresh, save_debug=True)
    
    # Light morphological opening to remove noise
    ksize = 5  # pixels, keep small
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (ksize, ksize))
    thresh = cv2.morphologyEx(thresh, cv2.MORPH_OPEN, kernel, iterations=1)
    show_image("Opened Threshold", thresh)

    # Size filter. Remove small components that are likely noise.
    # Careful with small reees and min component px selection
    """t_sf = time.perf_counter()
    n_comp, labels, stats, _ = cv2.connectedComponentsWithStats(thresh, connectivity=8)
    keep = stats[:, cv2.CC_STAT_AREA] >= MIN_COMPONENT_PX
    keep[0] = False                       # label 0 is background
    thresh = (keep[labels] * 255).astype(np.uint8)
    print(f"    size filter: {time.perf_counter() - t_sf:.2f}s | "
          f"{n_comp-1} comps -> {int(keep.sum())} kept (>= {MIN_COMPONENT_PX} px)")
    show_image("Size Filtered Threshold", thresh, save_debug=True)"""
    
    # Skeletonize to get 1-pixel wide representation of the tree
    skeleton = skeletonize(thresh/255).astype(np.uint8)

    clahe_overlay = cv2.createCLAHE(clipLimit=10.0, tileGridSize=(13, 13)).apply(gray) # Only for visualisation

    kernel = np.ones((3,3), np.uint8)
    overlay = overlay_skeleton_on_gray(clahe_overlay, 
                                       cv2.dilate(skeleton*255, kernel, iterations=1))
    show_image("Skeleton Overlay", overlay)

    # Bridging also needs finetuning - too much bridging can cause false connections or noise amp
    #TODO also fine tune this
    #skeleton_connected = bridge_endpoints_via_dilation(skeleton, max_bridge_dist=10)

    #overlay = overlay_skeleton_on_gray(gray, cv2.dilate(skeleton_connected, kernel, iterations=1))
    #show_image("Bridged Skeleton Overlay", overlay)
    
    # Crop BEFORE snapping the tip to avoid accidentaly cutting the tree 
    skeleton_left = skeleton.copy()
    skeleton_left[:, tip[0] + 1:] = 0

    adjusted_tip = snap_to_skeleton(skeleton_left, tip, radius=20)

    show_image("Adjusted Tip on Skeleton", overlay, tip=adjusted_tip)

    # Keep only the skeleton pixels connected to the tip
    main_tree_left = connected_skeleton_component(skeleton_left, adjusted_tip)

    # Guard against incorect tip placement: if the tip component is too small, re-snap to the largest component in the patch
    suspect = False
    comp_px = int((main_tree_left > 0).sum())


    _, _, l_stats, _ = cv2.connectedComponentsWithStats(
        (skeleton_left > 0).astype(np.uint8), connectivity=8)
    l_areas = l_stats[1:, cv2.CC_STAT_AREA]
    total_px = int(l_areas.max()) if l_areas.size else 0

    if total_px > 0 and comp_px < SUSPECT_FRAC * total_px:
        print(f"    [{CURRENT_IMAGE}] tip component {comp_px}/{total_px} px "
              f"- re-snapping to largest component")
        retry_tip = snap_to_skeleton(skeleton_left, tip, radius=20,
                                     prefer_global_largest=True)
        retry_tree = connected_skeleton_component(skeleton_left, retry_tip)
        retry_px = int((retry_tree > 0).sum())

        if retry_px > comp_px:
            adjusted_tip, main_tree_left, comp_px = retry_tip, retry_tree, retry_px
            print(f"    [{CURRENT_IMAGE}] re-snap recovered {retry_px} px")
        else:
            suspect = True
            print(f"    [{CURRENT_IMAGE}] re-snap did not help; marking suspect")

    show_image("Extracted Branches Overlay",
               overlay_skeleton_on_gray(clahe_overlay, cv2.dilate(main_tree_left, kernel, iterations=1)),
               tip=adjusted_tip, save_debug=True)

    # Find longest path from tip
    path_mask, path_length, far_xy = find_longest_path_from_tip(main_tree_left, adjusted_tip)
    path_mask_thick = cv2.dilate(path_mask, kernel, iterations=1)

    # Straight-line tip-to-far-end distance, as a sanity check against the geodesic
    euclid = math.hypot(far_xy[0] - adjusted_tip[0], far_xy[1] - adjusted_tip[1])

    # Build final overlay: skeleton in green, longest path in blue, tip marked
    skeleton_dilated = cv2.dilate(main_tree_left, kernel, iterations=1)
    final_overlay = overlay_skeleton_on_gray(clahe_overlay, skeleton_dilated)
    final_overlay = overlay_skeleton_on_gray(final_overlay, path_mask_thick, color=(255, 100, 0))
    cv2.circle(final_overlay, adjusted_tip, 6, (0, 0, 255), 2, cv2.LINE_AA)
    cv2.circle(final_overlay, far_xy, 6, (0, 255, 255), 2, cv2.LINE_AA)
    show_image("Longest Path Overlay", final_overlay, save_debug=True)

    print(f"[{CURRENT_IMAGE}] longest path: {path_length:.1f} px "
          f"= {path_length / PX_PER_MM:.4f} mm")

    return {
        'tip_x': int(adjusted_tip[0]),
        'tip_y': int(adjusted_tip[1]),
        'far_x': far_xy[0],
        'far_y': far_xy[1],
        'length_px': float(path_length),
        'length_mm': float(path_length) / PX_PER_MM,
        'euclid_px': float(euclid),
        'euclid_mm': float(euclid) / PX_PER_MM,
        'final_overlay': final_overlay,
        'comp_px': comp_px,
        'total_px': total_px,
        'suspect': suspect,
    }

 
def list_images(folder):
    paths = []
    for ext in IMG_EXTS:
        paths.extend(glob.glob(os.path.join(folder, ext)))
    # Case-insensitive filesystems (Windows) can return the same file twice
    seen, unique = set(), []
    for p in sorted(paths):
        key = os.path.normcase(os.path.abspath(p))
        if key not in seen:
            seen.add(key)
            unique.append(p)
    return unique


def process_one(path):
    """Run the full pipeline on a single image. Returns the result dict."""
    img = cv2.imread(path, cv2.IMREAD_COLOR)
    if img is None:
        raise IOError(f"cv2.imread returned None for {path}")

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    tip = needle_tip_detection_pipeline(gray, s_r=0.5)
    result = branch_extraction_pipeline(gray, tip)
    result['height'], result['width'] = gray.shape
    return result


def _init_worker():
    cv2.setNumThreads(1)  # Limit OpenCV to a single thread in each worker


def process_image_worker(path):
    """Full pipeline for one image, including the PNG write. Returns a CSV row.

    Catches its own exceptions: an uncaught one here would kill the pool.
    Writes the overlay itself so the 36 MB array never gets pickled back.
    """
    global CURRENT_IMAGE
    CURRENT_IMAGE = os.path.splitext(os.path.basename(path))[0]

    row = {
        'filename': os.path.basename(path),
        'length_px': '', 'length_mm': '',
        'euclid_px': '', 'euclid_mm': '',
        'tip_x': '', 'tip_y': '', 'far_x': '', 'far_y': '',
        'secs': '', 'status': 'ok', 'error': '',
    }

    t0 = time.perf_counter()
    try:
        res = process_one(path)

        overlay = res['final_overlay']
        if OVERLAY_SCALE != 1.0:
            overlay = cv2.resize(overlay, None, fx=OVERLAY_SCALE, fy=OVERLAY_SCALE,
                                 interpolation=cv2.INTER_AREA)

        out_path = os.path.join(OUT_DIR, f"{CURRENT_IMAGE}_final_overlay.jpg")
        if not cv2.imwrite(out_path, overlay, [cv2.IMWRITE_JPEG_QUALITY, 85]):
            raise IOError(f"cv2.imwrite failed for {out_path}")

        for k in ('tip_x', 'tip_y', 'far_x', 'far_y'):
            row[k] = res[k]
        row['length_px'] = round(res['length_px'], 2)
        row['length_mm'] = round(res['length_mm'], 5)
        row['euclid_px'] = round(res['euclid_px'], 2)
        row['euclid_mm'] = round(res['euclid_mm'], 5)

    except Exception as exc:
        row['status'] = 'failed'
        row['error'] = f"{type(exc).__name__}: {exc}"
        row['traceback'] = traceback.format_exc()

    row['secs'] = round(time.perf_counter() - t0, 2)

    if res['suspect']:
        row['status'] = 'suspect'
    return row


def main():
    if not os.path.isdir(IN_DIR):
        raise SystemExit(f"Input folder not found: {os.path.abspath(IN_DIR)}")

    os.makedirs(OUT_DIR, exist_ok=True)

    image_paths = list_images(IN_DIR)
    if not image_paths:
        raise SystemExit(f"No images matching {IMG_EXTS} in {os.path.abspath(IN_DIR)}")

    print(f"Found {len(image_paths)} image(s) in {IN_DIR}")
    print(f"Writing overlays to {OUT_DIR}")
    print(f"Calibration: {PX_PER_MM} px = 1 mm  ({1000.0 / PX_PER_MM:.4f} um/px)\n")

    print(f"Running {N_WORKERS} workers\n")

    rows = []
    batch_t0 = time.perf_counter()

    # Use a multiprocessing pool to process images in parallel. Each worker runs the full pipeline for one image.
    with mp.Pool(processes=N_WORKERS, initializer=_init_worker) as pool:
        # chunksize=1 so fast P-cores keep pulling work instead of waiting on
        # a slow E-core to finish a preassigned block
        results = pool.imap_unordered(process_image_worker, image_paths, chunksize=1)

        for done, row in enumerate(results, 1):
            rows.append(row)
            elapsed = time.perf_counter() - batch_t0
            eta = (elapsed / done) * (len(image_paths) - done)
            if row['status'] == 'ok':
                flag = ''
            elif row['status'] == 'failed':
                flag = '  FAILED: ' + row['error']
            else:
                flag = f"  [{row['status']}]"
            print(f"[{done}/{len(image_paths)}] {row['filename']} "
                  f"{row['secs']:.1f}s | ETA {eta/60:.1f} min{flag}")
            if row.get('traceback'):
                print(row.pop('traceback'))

    # imap_unordered returns in completion order, not filename order
    rows.sort(key=lambda r: r['filename'])

    fields = ['filename', 'length_px', 'length_mm', 'euclid_px', 'euclid_mm',
              'tip_x', 'tip_y', 'far_x', 'far_y', 'secs', 'status', 'error',]
    
    with open(CSV_PATH, 'w', newline='', encoding='utf-8') as f:
        writer = csv.DictWriter(f, fieldnames=fields)
        writer.writeheader()
        writer.writerows(rows)

    n_ok = sum(r['status'] == 'ok' for r in rows)
    print(f"Done. {n_ok}/{len(rows)} succeeded. CSV -> {CSV_PATH}")
    print(f"Batch time: {(time.perf_counter() - batch_t0)/60:.1f} min")

    if n_ok:
        lengths = [r['length_mm'] for r in rows if r['status'] == 'ok']
        print(f"Longest branch: min {min(lengths):.4f} mm | "
              f"median {sorted(lengths)[len(lengths) // 2]:.4f} mm | "
              f"max {max(lengths):.4f} mm")


if __name__ == '__main__':
    if ENABLE_SHOW_IMAGES:
        print("Image display is ENABLED - the run will block on every step. "
              "Set ENABLE_SHOW_IMAGES=False for a batch run.\n")
    main()